<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="theme-color" content="#2c1f18">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Chinny &amp; Gilby — Wedding</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Jost:wght@300;400;500&family=Marcellus&family=Pinyon+Script&display=swap"
    rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Mea+Culpa&display=swap" rel="stylesheet">
  <style>
    /* ===== TOKENS — change colors/fonts here ===== */
    :root {
      color-scheme: dark;
      /* Script font: uses Blosta Script if you add the licensed file (see @font-face), otherwise Pinyon Script.
     Free look-alike to try instead: swap to 'Ballet' (add &family=Ballet to the Google Fonts link). */
     
      --bg: #2c1f18;
      --ink: #f3ead8;
      --gold: #b79a5b;
      --title: #fbf4e6;
      --sage-dark: #7a5a30;
      --blush: #4b3a2c;
      --serif: 'Cormorant Garamond', Georgia, serif;
      --sans: 'Jost', system-ui, sans-serif;
       --script: 'Blosta Script', cursive;
      --ease: cubic-bezier(.65, 0, .35, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    html,
    body {
      height: 100%
    }

    body {
      font-family: var(--sans);
      color: var(--ink);
      background: var(--bg);
      overflow: hidden;
      font-weight: 300
    }

    button {
      font: inherit;
      cursor: pointer;
      border: 0;
      background: none;
      color: inherit
    }

    :focus-visible {
      outline: 2px solid var(--gold);
      outline-offset: 3px
    }

    /* ===== PHOTO PLACEHOLDERS =====
   Replace with: <img src="your-photo.jpg" alt="..."> inside .photo,
   or set background-image on the .photo element. */
    .photo {
      background: linear-gradient(135deg, #4b3a2c, #37291f);
      display: grid;
      place-items: center;
      color: #cdbd9f;
      font-size: .8rem;
      letter-spacing: .05em;
      overflow: hidden;
      position: relative
    }

    .photo img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover
    }

    /* ===== INTRO: ENVELOPE SCENE =====
   Optional: put a blurred flower/venue photo behind it by adding
   --intro-bg:url(bg.jpg); to #intro below. */

    #intro-new{
      width: 100%;
      height: 100vh;
      background-image: url('./envelopeS.png');
      background-size:cover;
      background-position: center;
      background-repeat: no-repeat;
    }

    #intro-new img{
      width: 100%;
    }



    #intro {
      position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: flex;
    justify-content: center;
    }

    #intro video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -1;
      opacity: 0.8;
    }

    #intro::before {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(18, 14, 6, .35)
    }

    #intro.done {
      opacity: 0;
      visibility: hidden
    }

    .scene {
      --out: cubic-bezier(.22, 1, .36, 1);
      position: relative;
      z-index: 1;
      container-type: inline-size;
      color: #f6efe0;
      width: min(100vw, calc(min(100dvh, 860px)*361/737));
      aspect-ratio: 361/737
    }

    .title {
      position: absolute;
      top: 30%;
      left: 0;
      right: 0;
      text-align: center;
      animation: fadeUp 1.6s var(--out) both;
      transition: 0.5s ease-in;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(2cqw)
      }

      to {
        opacity: 1;
        transform: none
      }
    }

    .title small {
      display: block;
      font: 6cqw/1.2 'Marcellus', serif;
      letter-spacing: .07em;
      text-transform: uppercase
    }

    .title .names {
      display: block;
      font: 15.5cqw/1.1 var(--script);
      white-space: nowrap;
      margin-top: 1cqw
    }

    .title .names i {
      font-style: normal;
      font-size: .62em;
      margin: 0 .1em
    }

    .stage {
      position: absolute;
      left: 0;
      right: 0;
      top: 22%;
      height: 60%;
      cursor: pointer
    }

    /* envelope parts share one box */
    .env-back,
    .env-front,
    .flap {
      position: absolute;
      left: 13%;
      width: 78%;
      top: 54%;
      height: 41%
    }


.env-back::after,
.flap .out::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background: url('envelopeOpen.png') center / cover, #8a6a38;
  opacity: 0;
  transition: opacity .9s ease .35s;     /* .35s = starts as the flap lifts */
}

/* AFTER opening: fade to light brown */
.opening .env-back::after,
.opening .flap .out::after {
  opacity: 1;
}

    .env-back .flap{
      background: linear-gradient(#a3834a, #6e4c2b 55%, #3a2216);
      border-radius: 1cqw
    }
    .env-back {
      background-image: url('/envelopeCopy.png');
      background-repeat: repeat;
      background-size: cover;
      border-radius: 1cqw
    }

    .env-front {
      z-index: 5;
      border-radius: 1cqw;
      clip-path: polygon(0 0, 50% 56%, 100% 0, 100% 100%, 0 100%);
      
      background-image: url('/envelope.png');
      background-repeat: repeat;
      background-size: cover;
    }

    
  .opening .env-front-cover {
      opacity: 1;
      transition: opacity .5s var(--ease)
    }


 /* .env-front-cover {
  z-index: 5;
  position: absolute;
  top: 73%;
  left: 22%;
  width: 232px;
  height: 152PX;
  aspect-ratio: 1 / 1;
  background-image: url('/envelopeCopy.png');
  background-repeat: no-repeat;
  background-size: contain;
  clip-path: polygon(30% 0, 80% 0%, 100% 50%, 10% 50%);
  opacity: 0;
} */


 .env-front-cover {
  z-index: 5;
  position: absolute;
  top: 73%;                    /* % of the stage, so it scales with the envelope */
  left: 22%;
  width: 55%;                  /* was 232px: fixed pixels broke on other screen sizes. Tune this one number */
  height: auto;
  aspect-ratio: 232 / 152;     /* keeps the same shape at every size */
  background-image: url('/envelopeCopy.png');
  background-repeat: no-repeat;
  background-size: contain;
  clip-path: polygon(30% 0, 80% 0%, 100% 50%, 10% 50%);
  opacity: 0;
}


    .flap {
      height: 32%;
      z-index: 6;
      transform-origin: top;
      transition: transform .9s var(--ease), z-index 0s .45s
    }

    .flap .face {
  position: absolute;
  inset: 0;
  clip-path: polygon(-10px 0px, 100% 0px, 50% 100%);
  backface-visibility: hidden;
}
    .flap .out {
      /* background: linear-gradient(#3b2418, #2c1a11) */
  background-image: url('/envelopeCopy.png');
      background-repeat: repeat;
      background-size: cover;
    }

    .flap .in {
      background: linear-gradient(#b8975b, #8a6a38);
      transform: rotateX(180deg)
    }

    .opening .flap {
      transform: rotateX(180deg);
      z-index: 1
    }

    .opening .title{
      top: 10.6%;
        transition: 0.5s ease-in;
    }

    /* things that rise out of the envelope */
    .card,
    .pol {
      position: absolute;
      z-index: 2;
      transform-origin: bottom center;
      opacity: 0;
      transform: translateY(var(--dy)) rotate(var(--rot)) scale(.6);
      transition: transform 1.5s var(--out), opacity .5s
    }

    .opening .card,
    .opening .pol {
      opacity: 1;
      transform: rotate(var(--rot))
    }

    .card {
      --dy: 46%;
      --rot: 13deg;
      left: 35%;
      top: 10%;
      width: 51%;
      height: 64%;
      text-align: center;
      padding: 15cqw 4cqw 0;
      background-image: url('./card-new.png');
      background-repeat: no-repeat;
      background-size: cover;
    }

    .opening .card {
      transition-delay: .9s
    }


    .pol {
      background: #fbfaf6;
      padding: 2.6cqw 2.6cqw 9cqw;
      box-shadow: 0 2cqw 4cqw rgba(0, 0, 0, .4)
    }

    .pol .photo {
      aspect-ratio: 1.1;
      width: 100%
    }

    .pol1 {
      --dy: 165%;
      --rot: 5deg;
      left: 16%;
      top: 13%;
      width: 33%
    }

    .pol2 {
      --dy: 88%;
  --rot: -14deg;
  left: 18%;
  top: 35%;
  width: 39%;
  z-index: 3;
    }

    .opening .pol1 {
      transition-delay: 1.25s
    }

    .opening .pol2 {
      transition-delay: 1.5s
    }

    /* wax seal, monogram, rose */
    .seal {
      position: absolute;
      z-index: 7;
      left: 52%;
      top: 77%;
      width: 31%;
      aspect-ratio: 1;
      translate: -50% -50%;
      scale: .5;
      rotate: -8deg;
      border-radius: 50%;
      display: grid;
      place-items: center;
      color: #8a6d33;
      font: 11cqw var(--script);
      /* background: radial-gradient(circle at 35% 28%, #f3e3ad, #d3b56c 55%, #a2813c); */
      background-image: url('/Logo.png');
      background-repeat: no-repeat;
      background-size: cover;
      /* box-shadow: 0 1.5cqw 3cqw rgba(0, 0, 0, .45), inset 0 0 0 2.2cqw rgba(255, 255, 255, .12), inset 0 0 0 2.6cqw #c9aa5f; */
      transition: left 1.1s var(--out) .15s, top 1.1s var(--out) .15s, scale 1.1s var(--out) .15s, rotate 1.1s var(--out) .15s
    }

    .opening .seal {
      left: 17.5%;
      top: 79%;
      scale: 1;
      rotate: 0deg
    }

    .mono {
      position: absolute;
      z-index: 6;
      left: 52%;
      top: 84%;
      width: 17%;
      aspect-ratio: .8;
      translate: -50% -50%;
      display: grid;
      place-items: center;
      opacity: 0;
      transition: opacity 1s 1.9s
    }

    .mono img{
      width: 100%;
    }

    .opening .mono {
      opacity: 1
    }

    .rose {
  position: absolute;
  z-index: 7;
  left: 48%;
  top: 68%;
  width: 22%;
  opacity: 0;
  transform: translateY(-8cqw) rotate(-25deg);
  transition: transform 1.2s var(--out) 2.1s, opacity .6s 2.1s;
  filter: drop-shadow(0 1cqw 1.5cqw rgba(0, 0, 0, .4));
}

    .opening .rose {
      opacity: 1;
      transform: none
    }

    .rose svg,
    .rose img {
  width: 280%;
  display: block;
  transform: rotate(-44deg);
}

    /* bottom text + buttons */
    .foot,
    .hint {
      position: absolute;
      left: 0;
      right: 0;
      text-align: center;
      z-index: 2
    }

    .hint {
      bottom: 6%;
      transition: opacity .5s
    }

    .opening .hint {
      opacity: 0;
      pointer-events: none
    }

    .foot {
      bottom: 3.5%;
      opacity: 0;
      transform: translateY(3cqw);
      pointer-events: none;
      transition: opacity 1s 2.4s, transform 1s var(--out) 2.4s
    }

    .opening .foot {
      opacity: 1;
      transform: none;
      pointer-events: auto
    }

    .foot p {
      font: 5.6cqw/1.3 'Marcellus', serif;
      letter-spacing: .05em;
      text-transform: uppercase;
      max-width: none
    }

    .cbtn {
      display: inline-block;
      margin-top: 4cqw;
      padding: 3.2cqw 8cqw;
      background: #7a5a30;
      color: #f6efe0;
      font: 3.6cqw 'Marcellus', serif;
      letter-spacing: .08em;
      text-transform: uppercase;
      transition: background .3s
    }

    .cbtn:hover {
      background: #9a7840
    }

    .hint .cbtn {
      background: none;
      border: 1px solid rgba(246, 239, 224, .6);
      border-radius: 99px;
      margin: 0;
      animation: pulse 2.2s ease-in-out infinite
    }

    .hint .cbtn:hover {
      background: #f6efe0;
      color: #3a2216
    }

    @keyframes pulse {
      50% {
        opacity: .55
      }
    }

    /* ===== ZOOM INTRO: starts zoomed-in on the closed envelope, zooms out when opened ===== */
    /* the zoom values (--zs, --zx, --zy, --zox, --zoy, --seal0) are set by JS so it fills ANY screen size */
    #intro:not(.ready) .scene { opacity: 0 }
    .stage {
      transform-origin: var(--zox, 50%) var(--zoy, 50%);
      transform: translate(var(--zx, 0px), var(--zy, 0px)) scale(var(--zs, 1));
      transition: transform 2.6s cubic-bezier(.45, 0, .2, 1)
    }
    .opening .stage { transform: none }

    /* seal: starts at the size that looks right while zoomed in */
    .seal { scale: var(--seal0, .5) }

    /* title: hidden while closed, fades in after the zoom-out starts (position stays yours: 10.6%) */
    .title { top: 10.6%; opacity: 0; animation: none; transition: opacity 1s 1.4s }
    .opening .title { opacity: 1; transition: opacity 1s 1.4s }

    /* closed-envelope text (sized by the screen, not by the scene) */
    .cover {
      position: absolute;
      inset: 0;
      z-index: 3;
      pointer-events: none;
      text-align: center;
      color: #fbf4e6;
      transition: opacity .7s
    }
    .opening .cover { opacity: 0 }
    .cv-names {
      position: absolute;
      left: 0;
      right: 0;
      top: 13%
    }
    .cv-names img { width: min(78vw, 880px); max-height: 30vh; object-fit: contain; filter: drop-shadow(0 2px 18px rgba(0, 0, 0, .45)) }
    .cv-bottom { position: absolute; left: 0; right: 0; bottom: 8%; }
    .cv-bottom p {
      font: clamp(1.1rem, 2.6vw, 2rem) 'Marcellus', serif;
      letter-spacing: .08em;
      text-transform: uppercase;
      margin-bottom: 1.6rem
    }
    .cv-bottom .hint { position: static; pointer-events: auto }
    .cv-bottom .hint .cbtn {
      margin: 0;
      padding: .85rem 2.4rem;
      background: #7a5a30;
      border: 0;
      border-radius: 0;
      font: clamp(.8rem, 1.4vw, 1.1rem) 'Marcellus', serif;
      animation: none
    }
    .cv-bottom .hint .cbtn:hover { background: #9a7840; color: #f6efe0 }

    /* ===== SITE SHELL ===== */
    #site {
      height: 100%;
      opacity: 0;
      transition: opacity 1s .2s
    }

    #site.show {
      opacity: 1
    }

    /* ===== PAGES ===== */
    main {
      position: absolute;
      inset: 0;
      overflow: hidden
    }

    .page {
      position: absolute;
      inset: 0;
      overflow-y: auto;
      overflow-x: hidden;
      visibility: hidden;
      opacity: 0;
      transform: translateX(60px);
      transition: transform .7s var(--ease), opacity .6s var(--ease), visibility 0s .7s
    }

    .page.active {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0s
    }

    .page.leaving {
      transform: translateX(-60px)
    }

    .reveal {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity .9s var(--ease), transform .9s var(--ease);
}
.reveal.show {
  opacity: 1;
  transform: none;
}

.para-contatin {
    width: fit-content;
    margin: 0 auto;
    text-align: left;
}

.para-contatin p {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
}

.para-contatin p::before {
    content: '';
    display: inline-block;
    flex-shrink: 0;

    width: 20px;
    height: 20px;

    background-image: url('./x-logo.png');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

    .sec {
      max-width: 720px;
      margin: 0 auto;
      padding: clamp(3.5rem, 9vw, 6rem) 1.5rem;
      text-align: center
    }

    .sec.first {
      padding-top: clamp(2.5rem, 7vw, 4rem)
    }

    .sec.wide {
      max-width: 1000px
    }

    .script {
      font: 400 clamp(3.6rem, 13vw, 6rem)/1 var(--script);
      color: var(--title);
      margin-bottom: 1.6rem
    }

    .script-rsvp{
      font: 400 clamp(3.6rem, 13vw, 6rem)/1 'Marcellus', serif;
      color: var(--title);
      margin-bottom: 1.6rem
    }

    .btn {
      display: inline-block;
      margin-top: 1.8rem;
      padding: .9rem 2.2rem;
      background: var(--sage-dark);
      color: #fbf7ec;
      border-radius: 99px;
      letter-spacing: .2em;
      font-size: .8rem;
      text-transform: uppercase;
      transition: background .3s, transform .3s
    }

    .btn:hover {
      background: var(--gold);
      transform: translateY(-2px)
    }

    /* OUR STORY (dark, like the Canva page) */
    .sec p {
      font: 500 clamp(1.05rem, 2.6vw, 1.2rem)/1.75 var(--serif);
      color: #eadfca;
      max-width: 52ch;
      margin: 0 auto 1.4rem
    }

    .frame {
      border: 1px solid var(--gold);
      padding: 3px;
      width: 100%;
      margin-bottom: 2.4rem
    }

    .frame .photo {
      aspect-ratio: 16/9;
      width: 100%;
      z-index: -1;
    }

    .lace {
     width: min(100%, 430px);
  margin: 0 auto 1.8rem;
  border: clamp(30px, 10vw, 50px) solid transparent;     /* border thickness */
  border-image: url('./border.png') 150 round;        /* your image + slice size */
  background: #a99d8b;                                   /* paper color inside the frame */
  background-clip: padding-box;
    }

    .lace .photo {
      aspect-ratio: 4/3;
      outline: 6px solid #a99d8b
    }

    .h4 {
      font: 400 clamp(1.15rem, 3.4vw, 1.4rem) 'Marcellus', serif;
      letter-spacing: .05em;
      text-transform: uppercase;
      margin-bottom: .8rem; 
      color: #d8bf94;
    }

    .sec a {
      color: #d8bf94;
      font: .8rem 'Marcellus', serif;
      letter-spacing: .1em;
      text-transform: uppercase
    }

    .info {
      margin-bottom: 3.4rem
    }

    .ico {
      width: 42px;
      height: 42px;
      margin: 0 auto .6rem;
      stroke: #c9ad7a;
      fill: none;
      stroke-width: 1.2;
      display: block
    }

.pal {
  display: grid;
  grid-template-columns: repeat(2, clamp(76px, 20vw, 86px));
  justify-content: center;
  justify-items: center;
  align-items: center;
  gap: 20px 5rem;
  margin-top: .4rem;
}

.pal i {
    width: 120px;
    height: 120px;
    border-radius: 50%;

    display: flex;
    justify-content: center;
    align-items: center;

    color: #f5eee5;
    font: normal 20px var(--serif);
    text-align: center;
    line-height: 1.1;
    font-style: normal;
}

/* Center the fifth circle */
.pal i:last-child {
    grid-column: span 2;
    justify-self: center;
}
    /* countdown band (Our Story page) */
    .band {
      background: rgba(255, 255, 255, .13);
      padding: 2rem 1rem 2.2rem;
      text-align: center
    }

    .band h3 {
      font: 400 clamp(1rem, 3vw, 1.2rem) 'Marcellus', serif;
      letter-spacing: .05em;
      text-transform: uppercase;
      margin-bottom: 1.2rem
    }

    .cd {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      gap: clamp(.5rem, 3vw, 1.4rem)
    }

    .cd div {
      min-width: 3.4rem
    }

    .cd b {
      display: block;
      font: 400 clamp(2rem, 8vw, 2.8rem)/1.1 var(--serif);
      color: #d8bf94
    }

    .cd small {
      font: .7rem 'Marcellus', serif;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: #d8bf94
    }

    .cd .colon {
      min-width: 0;
      font-size: clamp(1.6rem, 6vw, 2.2rem);
      line-height: 1.2;
      color: var(--ink)
    }

    /* RSVP button section at the bottom of the page */

   .rsvp-btm {
      max-width: 1920px;
      position: relative;
     text-align: center;
     left:50%;
      transform: translateX(-50%);
      background-image: url('./bot-rsvpwallpaper.png');
      background-size:cover;
      background-repeat: no-repeat;
   }


    .rsvp-bg {
      max-width: 1920px;
      position: relative;
     text-align: center;
     left:50%;
      transform: translateX(-50%);
      /* background: linear-gradient(rgba(44, 31, 24, .55), rgba(44, 31, 24, .55)), var(--rsvp-bg, radial-gradient(70% 60% at 25% 65%, #6a6842, #2c1f18)) center/cover */
    }

    .rsvp-bg video{
   position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -1;
      opacity: 0.5;
    }

    .mini {
      display: flex;
      justify-content: center;
      margin: 1.8rem 0 1.4rem;
      position: relative;
    }

    .menv {
      width: min(40vw, 150px);
      aspect-ratio: 1/1.1;
      background: URL('./rsvpCard.png') center/contain;
      /* clip-path: polygon(50% 0, 100% 22%, 100% 100%, 0 100%, 0 22%); */
      /* display: grid; */
      background-repeat: no-repeat;
      place-items: center;
      font: 1rem 'Marcellus', serif;
      z-index:2;
      margin-top: -10%;
      margin-right: -2%;
    }

    .mcard {
      width: min(33vw, 125px);
      aspect-ratio: .62;
      background: url('/cardrsvp.png') center/cover;
      margin: 18px 0 0 -6px;
      display: grid;
      place-items: center;
      font: 2.2rem var(--script)
    }
.mcard::after {
  content: '';
  position: absolute;
  width: clamp(200px, 15vw, 200px);
  aspect-ratio: 1;
  background: url('/floral.png') center/contain no-repeat;
  left: 40%;
  bottom: -20%;
  transform: translateX(-50%);
  z-index: -1;
  pointer-events: none;
  z-index: 3;
}

    /* RSVP — full-screen dark page, like the sample */
    #rsvp {
      position: fixed;
      inset: 0;
      z-index: 20;
      background: #2c1f18;
      color: #f3ead8;
      padding: clamp(1.5rem, 5vw, 3rem)
    }

    #rsvp .wrap {
      max-width: 560px;
      margin: 0 auto;
      padding-bottom: 3rem
    }

    .back {
      display: inline-flex;
      align-items: center;
      gap: .7rem;
      font: 1.4rem 'Marcellus', serif;
      font-variant: small-caps;
      letter-spacing: .03em;
      padding: .3rem 0
    }

    .back svg {
      width: 2.4rem;
      transition: transform .3s
    }

    .back:hover svg {
      transform: translateX(-5px)
    }

    .kindly {
      text-align: right;
      margin: 2rem 0 2.8rem;
      line-height: .85
    }

    .kindly span {
      display: block;
      font: clamp(4rem, 16vw, 5.2rem)/1 var(--script);
      margin-bottom: -.28em
    }

    .kindly b {
      display: block;
      font: 400 clamp(2.4rem, 9vw, 3.2rem)/1 'Marcellus', serif;
      letter-spacing: .02em;
      text-transform: uppercase
    }

    .fld {
      margin-bottom: 1.7rem
    }

    .lbl {
      display: block;
      font: .78rem/1.5 'Marcellus', serif;
      text-transform: uppercase;
      letter-spacing: .04em;
      margin-bottom: .6rem
    }

    .txt {
      width: 100%;
      height: 46px;
      background: transparent;
      border: 1px solid rgba(255, 255, 255, .2);
      border-radius: 4px;
      color: inherit;
      padding: 0 .9rem;
      font: 1rem var(--sans);
      transition: border-color .3s
    }

    .txt:focus {
      outline: none;
      border-color: #b79a5b
    }

    .opt {
      display: block;
      position: relative;
      margin-bottom: .6rem
    }

    .opt input {
      position: absolute;
      opacity: 0;
      inset: 0
    }

    .opt span {
      display: block;
      padding: .9rem 1rem;
      background: rgba(255, 255, 255, .14);
      border-radius: 4px;
      cursor: pointer;
      font: .78rem 'Marcellus', serif;
      text-transform: uppercase;
      letter-spacing: .04em;
      border: 1px solid transparent;
      transition: background .3s, border-color .3s
    }

    .opt:hover span {
      background: rgba(255, 255, 255, .2)
    }

    .opt input:checked+span {
      background: rgba(183, 154, 91, .35);
      border-color: #b79a5b
    }

    .opt input:focus-visible+span {
      outline: 2px solid #b79a5b;
      outline-offset: 2px
    }

    .send {
      width: 100%;
      padding: 1rem;
      margin-top: .6rem;
      background: rgba(255, 255, 255, .08);
      border-radius: 6px;
      color: inherit;
      font: .85rem 'Marcellus', serif;
      text-transform: uppercase;
      letter-spacing: .08em;
      transition: background .3s
    }

    .send:hover:not(:disabled) {
      background: rgba(183, 154, 91, .4)
    }

    .send:disabled {
      opacity: .6;
      cursor: wait
    }

    #msg {
      min-height: 1.4em;
      margin-top: 1rem;
      font-size: .85rem;
      text-align: center;
      color: #e8c9a0
    }

    .hp {
      position: absolute;
      left: -9999px;
      opacity: 0
    }

    .thanks {
      text-align: center;
      padding: 3rem 0
    }

    .thanks span {
      display: block;
      font: 3.4rem/1.1 var(--script);
      margin-bottom: 1rem
    }

    .thanks p {
      margin: 0 auto;
      font-size: 1rem
    }

    @media (max-width: 600px) {
     .opening .title {
  top: 10.6%;
}

.title small {
  display: block;
  font: 4cqw/1.2 'Marcellus', serif;
}

.title .names {
  display: block;
  font: 12.5cqw/1.1 var(--script);
}
    }

    @media(prefers-reduced-motion:reduce) {
      * {
        transition-duration: .01s !important;
        transition-delay: 0s !important;
        animation: none !important
      }
    }

    /* Blosta Script is a paid font. After buying a WEB license, upload the file as fonts/BlostaScript.woff2 */
    @font-face {
    font-family: 'Blosta Script';
    src: url('./Blosta-Script.otf') format('opentype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
}
  </style>
</head>

<body>
  <!-- <section id="intro-new" aria-label="Invitation cover">
    
    </section> -->

  <!-- ===== INTRO ===== -->
  <section id="intro" aria-label="Invitation cover">
    <video autoplay muted loop playsinline id="bgvid" aria-hidden="true">
      <source src="/bannervideo.mp4" type="video/mp4">
    </video>
    
    <!-- closed-envelope text: visible only before opening -->
    <div class="cover">
      <span class="cv-names"><img src="/chnygilyfont-intro.png" alt="Chinny &amp; Gilby"></span>
      <div class="cv-bottom">
        <p>A love redeemed by grace</p>
        <div class="hint"><button class="cbtn" id="openBtn">Tap to open</button></div>
      </div>
    </div>
    <div class="scene">
      <div class="title">
        <small>The wedding of</small>
        <img src="/chnygilyfont-intro.png" alt="Monogram" width="100%">
      </div>

      <div class="stage" id="stage">
        <div class="env-back"></div>

        <!-- Card (rises beside the photos) -->
        <div class="card">
          <!-- <small>Save the date</small>
          <span class="nm">Chinny &amp; Gilby</span>
          <small>Dec. 16, 2026</small>
          <small style="margin-top:1.5cqw">Chateau de Busay</small> -->
        </div>

        <!-- 2 photos: replace the placeholder text with <img src="photo1.jpg" alt=""> -->
        <div class="pol pol1">
          <div class="photo">
            <image src="/imageHome1.png" alt="Photo 1">
          </div>
        </div>
        <div class="pol pol2">
          <div class="photo">
            <image src="/imageHome2.png" alt="Photo 1">
          </div>
        </div>

        <div class="env-front"></div>
        <div class="flap">
          <div class="face out"></div>
          <div class="face in"></div>
        </div>
        <div class ="env-front-cover"> </div>
        <div class="mono"><image src="/logoIntro.png" alt="Monogram"></image></div>
        <div class="seal"></div>

        <!-- Rose: swap the SVG for <img src="rose.png" alt=""> (transparent PNG) if you have one -->
        <div class="rose">
         <img src="/flower.png" alt="Rose">
        </div>
      </div>

      <div class="foot">
        <p>Chateau de Busay<br>12.16.2026</p>
        <button class="cbtn" id="viewBtn">View details</button>
      </div>
    </div>
  </section>

  <!-- ===== SITE ===== -->
  <div id="site">
    <main>
      <!-- ONE PAGE: story, countdown, venue, dress code, RSVP button (RSVP form is a separate page, no tab) -->
      <section class="page active" id="story">
        <div class="sec first">
          <img src="/Our-testimony.png" alt="Monogram" width="100%">
          <div class="frame">
            <div class="photo">Your photo here</div>
          </div>
          <h1 style="font: 100 clamp(30px, 15vw, 35px)/1.2 var(--serif); margin-bottom: 2rem;">HIS GRACE LED US HERE</h1>
          &nbsp;
          <p class="reveal">How God Redeemed and Restored Our Love Story</p>
         
          &nbsp;
          <p class="reveal">For seven years, we shared a life together under one roof, never
imagining marriage as part of our future. We were comfortable with
what we had, blessed with our beautiful daughter, Chaya, and
sustained by God's grace even when we fell short.</p>
            &nbsp;
          <p class="reveal">When we reached our seventh year, we thought our relationship had
come to an end. We could no longer see a future together. But God, in
His faithfulness, led us to a church where we witnessed beautiful
examples of godly marriages. There, He encountered us, changed our
hearts, and restored what we thought had no future.</p>
&nbsp;
          <p class="reveal">As we surrendered our relationship to Him, He taught us to love
differently—to choose obedience, practice patience, and place Him at
the center of our love. What once seemed impossible became a desire
God planted in our hearts. In His perfect timing, God turned our story
around and led us toward the covenant of marriage.</p>
&nbsp;
          <p class="reveal">
Today, we celebrate not just our love for each other, but the God who
pursued us, restored us, and remained faithful through it all. This is our
love story, but above all, it is a testimony of God's grace, faithfulness,
and redeeming love.</p>

            <p class="reveal"><b>Even when we are faithless, He remains faithful.<span style="display: block;">— 2 Timothy 2:13 (TPT)</span></b></p>
         
          
        </div>

                <div class="band reveal">
          <h3>Counting down to forever</h3>
          <div class="cd" aria-label="Countdown to the wedding">
            <div><b id="d">0</b><small>Days</small></div>
            <div class="colon">:</div>
            <div><b id="h">00</b><small>Hours</small></div>
            <div class="colon">:</div>
            <div><b id="m">00</b><small>Minutes</small></div>
            <div class="colon">:</div>
            <div><b id="s">00</b><small>Seconds</small></div>
          </div>
        </div>

        <div class="sec reveal">
          <img src="/theVenue.png" alt="Venue" width="100%">
          <div class="h4">THE WEDDING CEREMONY & RECEPTION</div>
          <!-- lace frame: set --lace:url(lace.png) on .lace if you have the Canva frame as a PNG -->
          <div class="lace reveal">
            <div class="photo">
              <image src='/venueHouse.png' alt="Photo 1" width="100%">
            </div>
          </div>
          <div class="h4">Chateau de Busay</div>
          <p>9V6J+WJF, Lower Busay Nivel Hills, Cebu<br>Transcentral Hwy, Cebu City, 6000 Cebu</p>
          <a href="https://www.google.com/maps/search/?api=1&amp;query=Chateau+de+Busay+Cebu" target="_blank"
            rel="noopener" style="display: block; margin-bottom: 20px;">View on map</a>

                <div class="h4">Ceremony</div>
                   <h1 style="font: 100 clamp(10px, 15vw, 15px)/1.2 var(--sans); margin-bottom: 2rem;">3:30 PM</h1>
                   <div class="h4">Reception</div>
                   <h1 style="font: 100 clamp(10px, 15vw, 15px)/1.2 var(--sans); margin-bottom: 5rem;">6:00 PM</h1>
             <div class="info"">
             <img src="/Icon_Attendance.png" alt="Attendance" width="130px;" style="margin-bottom: 20px;">
            <div class="h4">Attendance</div>
            <p>We hope you understand that we are keeping our wedding an intimate
celebration. Due to space, we are only able to accommodate those
guests formally invited.</p>
          </div>
        </div>
       

        <div class="sec reveal">
          <img src="/dressCode.png" alt="Dress code" width="100%">
          <div class="info" style ="margin-top: 3rem">
            <img src ="Icon_Attire.png" alt="Attire" width="80px;" style="margin-bottom: 20px;">
            <div class="h4">Attire</div>
            <p>A Garden Celebration in Earth Tones as we celebrate this special day
surrounded by nature, we would love for our guests to wear attire that
complements the beauty of our garden setting.</p>
              <div ="grid-contain">
                <section ="padding" style="padding: 20px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 2fr)); gap: 20px; align-items: center;">
                  <div style="text-align: center;">
                    <img src="/Gentlemen.png" alt="Men" width="150px;" style="margin-bottom: 10px;"></img>
                    <div class="h4">GENTLEMAN</div>
                    <p>Men: Earth-toned suits or dress shirts with slacks. Consider shades of brown, beige, olive, or muted greens.</p>
                  </div>
                 
                  <div style="text-align: center;">
                    <img src="/Little-gentlemen.png" alt="Women" width="150px;" style="margin-bottom: 10px;"></img>
                     <div class ="h4">LITTLE GENTLEMAN</div>
                    <p>Short-sleeved Barong in neutral tones and black slacks.</p>
                  </div>
                     <div style="text-align: center;">
                    <img src="/Ladies.png" alt="Men" width="150px;" style="margin-bottom: 10px;"></img>
                    <div class="h4">LADIES</div>
                    <p>Long Gown.</p>
                  </div>
                 
                  <div style="text-align: center;">
                    <img src="/Little-ladies.png" alt="Women" width="150px;" style="margin-bottom: 10px;"></img>
                     <div class ="h4">LITTLE LADIES</div>
                    <p>Dress (Any Style)</p>
                  </div>
                </section>
              </div>
            </div>
          </div>


              <div class="rsvp-bg ">
    <video autoplay muted loop playsinline id="bgvid" aria-hidden="true">
        <source src="/rsvpbanner.mp4" type="video/mp4">
    </video>

    <div class="sec reveal">
      <div class="h4">Color Guide</div>
      <p>We would love to see everyone in beautiful earthtone shades!</p>
        <div class="pal" aria-label="Color palette">

            <i style="background:#4a2a18;">Walnut<br>Brown</i>
            <i style="background:#7a6a45;">Olive<br>Green</i>
            <i style="background:#8b3a22;">Terracotta</i>
            <i style="background:#b79c86;">Warm<br>Taupe</i>
            <i style="background:#bfa683;">Warm<br>Ivory</i>

        </div>
    </div>
</div>
       <div class="sec reveal">
          <div class="h4">DRESS CODE REMINDER</div>
          &nbsp;
          <p style="margin-bottom: 2rem">To maintain the elegance of our garden celebration, we kindly
          request that guests refrain from wearing the following:</p>
          &nbsp;
          <div class ="para-contatin" >
          <p>Jeans / Shorts</p>
          <p>Rubber shoes / Slippers</p>
          <p>T-Shirts / White Outfits</p>
          <p>Cocktail dresses</p>
          </div>
          &nbsp;
          <p>Thank you for honoring our dress code and being part of our special day.</p>
       </div>
     <div class="sec reveal">
          <img src="/Icon_Gifts.png" alt="RSVP" width="130px;" style="margin-bottom: 3rem;">
          <h1 style="font: 100 clamp(30px, 15vw, 35px)/1.2 var(--serif); margin-bottom: 2rem;">A NOTE ON GIFTS</h1>
          <p>Having you celebrate this special day with us is already
          a gift we will treasure.</p>
            &nbsp;
          <p>We are grateful to have you witness God's faithfulness
          in bringing us together and leading us into this new
          chapter.</p>
            &nbsp;
            <p>If you wish to bless us with a gift, a monetary
            contribution toward building our new home and
            beginning our married life together would be deeply
            appreciated.</p>
            &nbsp;
            <p>Thank you for your love and generosity!</p>
        </div>
      <div class="rsvp-bg">
                <video autoplay muted loop playsinline id="bgvid" aria-hidden="true">
      <source src="/rsvpbanner.mp4" type="video/mp4">
    </video>
          <div class="sec reveal">
            <img src="/rsvpText.png" alt="RSVP" width="100%">
            <p>As we begin our journey together, we'd love for you to join us in celebrating our big day. Your presence means the world
            to us, and we can't wait to create unforgettable memories together. Let's celebrate love, laughter, and happily ever
            after!</p>
            <!-- replace .mini with <img src="envelope.png" alt=""> if you have the Canva envelope image -->
            <div class="mini">
              <div class="menv"></div>
              <div class="mcard"></div>
            </div>
            <button class="btn" data-go="rsvp">Click here</button>
          </div>
        </div>

        <div class ="rsvp-btm">
        <div class="sec reveal">
        <div class="h3-bot">Our Entourage</div>
        <h2>Wedding Officiant</h2>
        </div>
        </div>
</section>

      <!-- RSVP -->
      <section class="page" id="rsvp">
        <div class="wrap">
          <button class="back" data-go="story" type="button">
            <svg viewBox="0 0 40 12" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
              <path d="M39 6H2M7 1 2 6l5 5" />
            </svg>
            Go back
          </button>

          <h2 class="kindly"><span>Kindly</span><b>Reply</b></h2>

          <form id="rsvpForm" novalidate>
            <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">

            <div class="fld">
              <label class="lbl" for="fname">Full name*</label>
              <input class="txt" id="fname" name="name" required autocomplete="name">
            </div>

            <fieldset class="fld" style="border:0">
              <legend class="lbl">Will you be attending?*</legend>
              <label class="opt"><input type="radio" name="attending" value="Wouldn't miss it for the world!"
                  required><span>Wouldn't miss it for the world!</span></label>
              <label class="opt"><input type="radio" name="attending" value="Sending love from afar."><span>Sending love
                  from afar.</span></label>
            </fieldset>

            <fieldset class="fld" style="border:0">
              <legend class="lbl">Will you be bringing a guest?*</legend>
              <label class="opt"><input type="radio" name="guest" value="Yes"><span>Yes</span></label>
              <label class="opt"><input type="radio" name="guest" value="No"><span>No</span></label>
            </fieldset>

            <div class="fld">
              <label class="lbl" for="gnames">Guest(s) name</label>
              <input class="txt" id="gnames" name="guest_names">
            </div>

            <div class="fld">
              <label class="lbl" for="diet">Do you or anyone of your party have dietary restrictions or
                allergies?*</label>
              <input class="txt" id="diet" name="dietary">
            </div>

            <button class="send" id="sendBtn" type="submit">Submit</button>
            <p id="msg" role="status"></p>
          </form>

          <div class="thanks" id="thanks" hidden>
            <span>Thank you</span>
            <p>Your reply has been sent. We can't wait to celebrate with you.</p>
          </div>
        </div>
      </section>
    </main>

  </div>


  <script>
    /* ===== Envelope open → View details → site ===== */
    const intro = document.getElementById('intro'), site = document.getElementById('site');
    /* zoom-in on the closed envelope: fills any screen, recalculated on resize */
    function setZoom() {
      const sc = intro.querySelector('.scene'), st = document.getElementById('stage');
      const env = st.querySelector('.env-back'), seal = st.querySelector('.seal');
      const W = intro.clientWidth, H = intro.clientHeight, ir = intro.getBoundingClientRect(), r = sc.getBoundingClientRect();
      const ox = env.offsetLeft + env.offsetWidth / 2, oy = env.offsetTop + env.offsetHeight / 2;   // envelope centre, inside the stage
      const cx = r.left - ir.left + st.offsetLeft + ox, cy = r.top - ir.top + st.offsetTop + oy;     // same point on screen
      const zs = Math.max(W / env.offsetWidth, H / env.offsetHeight) * 1.04;                         // "cover" scale
      const d = Math.min(Math.max(.11 * W, .13 * H), .22 * H);                                       // seal size while zoomed in
      st.style.transition = 'none';
      const set = (k, v) => intro.style.setProperty(k, v);
      set('--zox', ox + 'px'); set('--zoy', oy + 'px');
      set('--zx', (W / 2 - cx) + 'px'); set('--zy', (H / 2 - cy) + 'px');
      set('--zs', zs); set('--seal0', d / (seal.offsetWidth * zs));
      intro.classList.add('ready');
      requestAnimationFrame(() => requestAnimationFrame(() => st.style.transition = ''));
    }
    setZoom(); addEventListener('resize', setZoom); addEventListener('load', setZoom);
    const openEnv = () => intro.classList.add('opening');
    document.getElementById('openBtn').addEventListener('click', openEnv);
    document.getElementById('stage').addEventListener('click', openEnv);
    document.getElementById('viewBtn').addEventListener('click', () => { intro.classList.add('done'); site.classList.add('show') });

    /* ===== Page switch: the long page <-> the RSVP form (RSVP has no tab) ===== */
    let current = 'story';
    function go(id) {
      if (id === current) return;
      const from = document.getElementById(current), to = document.getElementById(id);
      from.classList.remove('active'); from.classList.add('leaving');
      setTimeout(() => from.classList.remove('leaving'), 700);
      if (id === 'rsvp') to.scrollTop = 0;   // the story page keeps your scroll position when you come back
      to.classList.add('active'); current = id;
    }
    document.addEventListener('click', e => {
      const b = e.target.closest('[data-go]'); if (b) go(b.dataset.go);
    });

    /* ===== Countdown — set your wedding date here ===== */
    const target = new Date('2026-12-16T16:00:00');
    function tick() {
      const t = Math.max(0, target - new Date()), f = n => String(n).padStart(2, '0');
      document.getElementById('d').textContent = Math.floor(t / 864e5);
      document.getElementById('h').textContent = f(Math.floor(t / 36e5) % 24);
      document.getElementById('m').textContent = f(Math.floor(t / 6e4) % 60);
      document.getElementById('s').textContent = f(Math.floor(t / 1e3) % 60);
    }
    tick(); setInterval(tick, 1000);

    /* ===== RSVP → Google Apps Script → your Gmail (free) =====
       1) Follow the setup steps for apps-script-code.gs
       2) Paste the Web app URL it gives you below */
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbzSjhxgFmNv9-VdV8gL--IO1hWWTv0MpCF2QQhzlJG3Obgl8pmMp7wKFv7QHEgXf2Tp/exec';
    const rsvpForm = document.getElementById('rsvpForm'), msg = document.getElementById('msg'), sendBtn = document.getElementById('sendBtn');
    rsvpForm.addEventListener('submit', async e => {
      e.preventDefault();
      msg.textContent = '';
      if (!rsvpForm.name.value.trim()) { msg.textContent = 'Please enter your full name.'; rsvpForm.name.focus(); return }
      if (!rsvpForm.attending.value) { msg.textContent = 'Please tell us if you can attend.'; return }
      if (SCRIPT_URL.startsWith('PASTE')) { msg.textContent = 'Setup needed: paste your Apps Script URL into SCRIPT_URL.'; return }
      sendBtn.disabled = true; sendBtn.textContent = 'Sending…';
      try {
        // no-cors: the browser can't read Google's reply, so success = the request left without a network error
        await fetch(SCRIPT_URL, { method: 'POST', mode: 'no-cors', body: new URLSearchParams(new FormData(rsvpForm)) });
        rsvpForm.hidden = true; document.getElementById('thanks').hidden = false;
      } catch (err) {
        msg.textContent = 'Could not send. Check your connection and try again.';
        sendBtn.disabled = false; sendBtn.textContent = 'Submit';
      }
    });


    const io = new IntersectionObserver(entries => {
        entries.forEach(en => {
          if (en.isIntersecting) { en.target.classList.add('show'); io.unobserve(en.target); }
        });
      }, { threshold: 0.15 });
      document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</body>

</html>
